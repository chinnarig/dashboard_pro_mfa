# Production Environment Variables
# Copy this file to env.prod.yaml and update with actual values

# Database
DATABASE_URL: "postgresql://postgres:password@/postgres?host=/cloudsql/zlavox-ai:us-central1:mfa"

# NextAuth Configuration
NEXTAUTH_URL: "https://dashboard.zlavox.ai"
NEXTAUTH_SECRET: "CHANGE_THIS_SECRET_IN_PRODUCTION"

# Application URLs
NEXT_PUBLIC_APP_URL: "https://dashboard.zlavox.ai"
NEXT_PUBLIC_API_URL: "https://api.zlavox.ai"

# Environment
NODE_ENV: "production"
ENVIRONMENT: "prod"

# Optional: Google Cloud Storage (if using)
# GCS_PROJECT_ID: "zlavox-ai"
# GCS_BUCKET_NAME: "zlovoxai-images"
# GCS_CLIENT_EMAIL: "your-service-account@project.iam.gserviceaccount.com"
# GCS_PRIVATE_KEY: "your-private-key-here"
