# QA Environment Variables
# Copy this file to env.qa.yaml and update with actual values

# Database
DATABASE_URL: "postgresql://postgres:password@/postgres?host=/cloudsql/zlavox-qa:us-central1:mfa"

# NextAuth Configuration
NEXTAUTH_URL: "https://dashboard-qa.zlavox.ai"
NEXTAUTH_SECRET: "CHANGE_THIS_SECRET_IN_QA"

# Application URLs
NEXT_PUBLIC_APP_URL: "https://dashboard-qa.zlavox.ai"
NEXT_PUBLIC_API_URL: "https://api-qa.zlavox.ai"

# Environment
NODE_ENV: "production"
ENVIRONMENT: "qa"

# Optional: Google Cloud Storage (if using)
# GCS_PROJECT_ID: "zlavox-qa"
# GCS_BUCKET_NAME: "zlovoxai-images-qa"
# GCS_CLIENT_EMAIL: "your-service-account@project.iam.gserviceaccount.com"
# GCS_PRIVATE_KEY: "your-private-key-here"
