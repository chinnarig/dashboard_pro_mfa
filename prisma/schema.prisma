generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  company_id          String           @db.Uuid
  email               String           @unique @db.VarChar(255)
  password            String           @db.VarChar(255)
  fullName            String           @map("full_name") @db.VarChar(255)
  role                user_role        @default(USER)
  isActive            Boolean          @default(true) @map("is_active")
  emailVerifiedBool   Boolean          @default(false) @map("email_verified")
  mfaEnabled          Boolean          @default(false) @map("mfa_enabled")
  mfaSecret           String?          @map("mfa_secret") @db.VarChar(255)
  mfaBackupCodes      String?          @map("mfa_backup_codes")
  created_at          DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?        @db.Timestamptz(6)
  lastLogin           DateTime?        @map("last_login") @db.Timestamptz(6)
  name                String?
  username            String?          @unique
  image               String?
  bio                 String?
  verificationToken   String?          @unique
  verificationExpires DateTime?
  resetToken          String?          @unique
  resetTokenExpires   DateTime?
  audit_logs          audit_logs[]
  refresh_tokens      refresh_tokens[]
  companies           companies        @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([company_id], map: "idx_users_company_id")
  @@index([email], map: "idx_users_email")
  @@index([isActive], map: "idx_users_is_active")
  @@index([mfaEnabled], map: "idx_users_mfa_enabled")
  @@map("users")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_logs {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  company_id    String    @db.Uuid
  user_id       String?   @db.Uuid
  action        String    @db.VarChar(100)
  resource_type String?   @db.VarChar(50)
  resource_id   String?   @db.Uuid
  ip_address    String?   @db.VarChar(45)
  user_agent    String?
  extra_data    String?
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  companies     companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         User?     @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([action], map: "idx_audit_logs_action")
  @@index([company_id], map: "idx_audit_logs_company_id")
  @@index([created_at(sort: Desc)], map: "idx_audit_logs_created_at")
  @@index([user_id], map: "idx_audit_logs_user_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model companies {
  id             String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name           String       @db.VarChar(255)
  domain         String       @unique @db.VarChar(255)
  is_active      Boolean      @default(true)
  created_at     DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?    @db.Timestamptz(6)
  address        String?
  phone_number_1 String?      @db.VarChar(20)
  phone_number_2 String?      @db.VarChar(20)
  api_key        String?      @unique @db.VarChar(255)
  audit_logs     audit_logs[]
  users          User[]

  @@index([api_key], map: "idx_companies_api_key")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model refresh_tokens {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String    @db.Uuid
  token      String    @unique @db.VarChar(500)
  expires_at DateTime  @db.Timestamptz(6)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  revoked    Boolean   @default(false)
  users      User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([token], map: "idx_refresh_tokens_token")
  @@index([user_id], map: "idx_refresh_tokens_user_id")
}

enum user_role {
  ADMIN
  USER
}

enum userrole {
  ADMIN
  MANAGER
  USER
}
