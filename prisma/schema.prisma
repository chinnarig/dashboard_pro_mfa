generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================
// CORE MODELS
// =============================================

model OrgProject {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @map("z_id") @db.Uuid
  projectId     String    @unique @map("project_id") @db.VarChar(100)
  name          String    @db.VarChar(255)
  url           String?   @db.VarChar(255)
  sipUrl        String?   @map("sip_url")
  lkUrl         String?   @map("lk_url")
  lkApiKey      String    @unique @map("lk_api_key") @db.VarChar(255)
  lkApiSecret   String    @map("lk_api_secret")
  isActive      Boolean?  @default(true) @map("is_active")
  address       String?
  email         String?   @db.VarChar(255)
  phoneNumber1  String?   @map("phone_number_1") @db.VarChar(50)
  phoneNumber2  String?   @map("phone_number_2") @db.VarChar(50)
  createdAt     DateTime? @default(now()) @map("created_at")
  updatedAt     DateTime? @default(now()) @updatedAt @map("updated_at")

  // Relations
  users         User[]

  @@map("org_projects")
}

model User {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                 String    @unique @db.VarChar(255)
  password              String?   @map("password_hash") @db.VarChar(255)
  orgProjectId          String?   @map("org_project_id") @db.Uuid
  role                  String?   @default("Read") @db.VarChar(50)

  fullName              String?   @map("full_name") @db.VarChar(255)
  username              String?   @unique @db.VarChar(100)
  image                 String?
  bio                   String?
  phoneNumber           String?   @map("phone_number") @db.VarChar(50)

  // MFA
  mfaEnabled            Boolean?  @default(false) @map("mfa_enabled")
  mfaSecret             String?   @map("mfa_secret") @db.VarChar(255)
  mfaBackupCodes        String?   @map("mfa_backup_codes")
  mfaEnabledAt          DateTime? @map("mfa_enabled_at")

  // SSO
  ssoProvider           String?   @map("sso_provider") @db.VarChar(50)
  ssoProviderId         String?   @map("sso_provider_id") @db.VarChar(255)
  ssoEmail              String?   @map("sso_email") @db.VarChar(255)
  ssoMetadata           Json?     @map("sso_metadata")

  // Authentication
  authMethod            String?   @default("password") @map("auth_method") @db.VarChar(20)
  lastSsoLoginAt        DateTime? @map("last_sso_login_at")

  // Security
  isActive              Boolean?  @default(true) @map("is_active")
  isEmailVerified       Boolean?  @default(false) @map("is_email_verified")
  emailVerifiedAt       DateTime? @map("email_verified_at")
  lastLoginAt           DateTime? @map("last_login_at")
  lastLoginIp           String?   @map("last_login_ip") @db.Inet
  failedLoginAttempts   Int?      @default(0) @map("failed_login_attempts")
  lockedUntil           DateTime? @map("locked_until")
  passwordChangedAt     DateTime? @map("password_changed_at")

  createdAt             DateTime? @default(now()) @map("created_at")
  updatedAt             DateTime? @default(now()) @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  // Relations
  orgProject            OrgProject?  @relation(fields: [orgProjectId], references: [id], onDelete: SetNull)
  auditLogs             AuditLog[]
  sessions              UserSession[]
  securityEvents        SecurityEvent[] @relation("UserSecurityEvents")
  resolvedSecurityEvents SecurityEvent[] @relation("ResolvedByUser")

  @@index([email])
  @@index([isActive])
  @@index([ssoProvider, ssoProviderId])
  @@index([deletedAt])
  @@map("users")
}

model SsoProvider {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerName          String    @unique @map("provider_name") @db.VarChar(50)
  displayName           String?   @map("display_name") @db.VarChar(255)

  // OAuth
  clientId              String    @map("client_id") @db.VarChar(255)
  clientSecretEncrypted String    @map("client_secret_encrypted")
  authorizationUrl      String?   @map("authorization_url")
  tokenUrl              String?   @map("token_url")
  userInfoUrl           String?   @map("user_info_url")

  // Settings
  isEnabled             Boolean?  @default(true) @map("is_enabled")
  autoProvisionUsers    Boolean?  @default(false) @map("auto_provision_users")
  allowedDomains        String[]  @default([]) @map("allowed_domains")

  config                Json?

  createdAt             DateTime? @default(now()) @map("created_at")
  updatedAt             DateTime? @default(now()) @updatedAt @map("updated_at")

  @@index([isEnabled])
  @@map("sso_providers")
}

// =============================================
// PHONE NUMBERS
// =============================================

model PhoneNumber {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phoneNumber       String    @unique @map("phone_number") @db.VarChar(50)

  // Provider info
  provider          String    @db.VarChar(50)
  providerSid       String?   @map("provider_sid") @db.VarChar(255)
  trunkId           String?   @map("trunk_id") @db.VarChar(255)

  // Number details
  countryCode       String?   @map("country_code") @db.VarChar(10)
  numberType        String?   @map("number_type") @db.VarChar(50)

  // Availability
  isAvailable       Boolean?  @default(true) @map("is_available")
  assignedToAgentId String?   @map("assigned_to_agent_id") @db.Uuid

  // Capabilities
  supportsVoice     Boolean?  @default(true) @map("supports_voice")
  supportsSms       Boolean?  @default(false) @map("supports_sms")

  // Metadata
  friendlyName      String?   @map("friendly_name") @db.VarChar(255)
  notes             String?

  createdAt         DateTime? @default(now()) @map("created_at")
  updatedAt         DateTime? @default(now()) @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  // Relations
  agent             Agent?    @relation(fields: [assignedToAgentId], references: [id], onDelete: SetNull)

  @@index([isAvailable])
  @@index([provider])
  @@index([assignedToAgentId])
  @@index([deletedAt])
  @@map("phone_numbers")
}

// =============================================
// PROMPTS
// =============================================

model Prompt {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId               String    @map("agent_id") @db.Uuid

  // Prompt content
  greetingMessage       String?   @map("greeting_message")
  systemInstructions    String?   @map("system_instructions")

  // Conversation behavior
  endCallPhrases        String[]  @default([]) @map("end_call_phrases")
  enableInterruptions   Boolean?  @default(true) @map("enable_interruptions")
  silenceTimeoutSeconds Int?      @default(30) @map("silence_timeout_seconds")

  // Response configuration
  maxResponseLength     Int?      @map("max_response_length")
  responseStyle         String?   @map("response_style") @db.VarChar(50)

  // Version control
  version               Int?      @default(1)
  isActive              Boolean?  @default(true) @map("is_active")

  createdAt             DateTime? @default(now()) @map("created_at")
  updatedAt             DateTime? @default(now()) @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  // Relations
  agent                 Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([agentId, isActive])
  @@index([deletedAt])
  @@map("prompts")
}

// =============================================
// AGENTS
// =============================================

model Agent {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String    @db.VarChar(255)
  description       String?

  // Phone number (denormalized)
  phoneNumber       String?   @map("phone_number") @db.VarChar(50)

  // LiveKit
  livekitAgentName  String    @unique @map("livekit_agent_name") @db.VarChar(255)

  // Voice config
  voiceProvider     String?   @map("voice_provider") @db.VarChar(50)
  voiceId           String?   @map("voice_id") @db.VarChar(255)
  language          String    @default("en-US") @db.VarChar(10)

  // LLM config
  llmProvider       String?   @map("llm_provider") @db.VarChar(50)
  llmModel          String?   @map("llm_model") @db.VarChar(100)
  systemPrompt      String?   @map("system_prompt")
  temperature       Decimal?  @default(0.7) @db.Decimal(3, 2)
  maxTokens         Int?      @default(1000) @map("max_tokens")

  // Status
  status            String    @default("active") @db.VarChar(20)
  isPhoneActive     Boolean   @default(true) @map("is_phone_active")

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  // Relations
  phoneNumbers      PhoneNumber[]
  prompts           Prompt[]
  callLogs          CallLog[]

  @@index([name])
  @@index([status])
  @@index([phoneNumber])
  @@index([livekitAgentName])
  @@index([deletedAt])
  @@map("agents")
}

// =============================================
// CALL LOGS
// =============================================

model CallLog {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // LiveKit
  livekitRoomId     String    @map("livekit_room_id") @db.VarChar(255)

  // Agent
  agentId           String?   @map("agent_id") @db.Uuid

  // Call details
  direction         String    @db.VarChar(20)
  callerPhone       String    @map("caller_phone") @db.VarChar(50)
  agentPhone        String?   @map("agent_phone") @db.VarChar(50)

  // Timing
  startTime         DateTime  @map("start_time")
  endTime           DateTime? @map("end_time")
  durationSeconds   Int?      @map("duration_seconds")

  // Status
  status            String?   @db.VarChar(50)
  disconnectReason  String?   @map("disconnect_reason") @db.VarChar(100)

  // Disposition
  dispositionCode   String?   @map("disposition_code") @db.VarChar(50)
  dispositionNotes  String?   @map("disposition_notes")

  // Transcript & Analysis
  transcript        Json?
  analysis          Json?

  createdAt         DateTime? @default(now()) @map("created_at")
  updatedAt         DateTime? @default(now()) @updatedAt @map("updated_at")

  // Relations
  agent             Agent?    @relation(fields: [agentId], references: [id])

  @@index([agentId])
  @@index([direction])
  @@index([status])
  @@index([startTime(sort: Desc)])
  @@index([livekitRoomId])
  @@index([dispositionCode])
  @@index([callerPhone])
  @@map("call_logs")
}

// =============================================
// AUDIT & SECURITY
// =============================================

model AuditLog {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Who
  userId        String?   @map("user_id") @db.Uuid
  userEmail     String?   @map("user_email") @db.VarChar(255)
  userIp        String?   @map("user_ip") @db.Inet

  // What
  action        String    @db.VarChar(100)
  entityType    String    @map("entity_type") @db.VarChar(100)
  entityId      String?   @map("entity_id") @db.Uuid

  // Details
  description   String?
  oldValues     Json?     @map("old_values")
  newValues     Json?     @map("new_values")
  changes       Json?

  // Context
  requestMethod String?   @map("request_method") @db.VarChar(10)
  requestPath   String?   @map("request_path")
  userAgent     String?   @map("user_agent")
  sessionId     String?   @map("session_id") @db.VarChar(255)

  // SSO
  ssoProvider   String?   @map("sso_provider") @db.VarChar(50)

  // Result
  status        String?   @db.VarChar(20)
  errorMessage  String?   @map("error_message")

  createdAt     DateTime  @default(now()) @map("created_at")

  // Relations
  user          User?     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@index([ssoProvider])
  @@map("audit_logs")
}

model UserSession {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String?   @map("user_id") @db.Uuid

  sessionToken    String    @unique @map("session_token") @db.VarChar(255)
  refreshToken    String?   @unique @map("refresh_token") @db.VarChar(255)

  // Session type
  sessionType     String?   @default("password") @map("session_type") @db.VarChar(20)
  ssoProvider     String?   @map("sso_provider") @db.VarChar(50)

  ipAddress       String?   @map("ip_address") @db.Inet
  userAgent       String?   @map("user_agent")
  deviceInfo      Json?     @map("device_info")

  expiresAt       DateTime  @map("expires_at")
  lastActivityAt  DateTime? @default(now()) @map("last_activity_at")

  createdAt       DateTime? @default(now()) @map("created_at")

  // Relations
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@index([expiresAt])
  @@map("user_sessions")
}

model SecurityEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String?   @map("user_id") @db.Uuid

  eventType     String    @map("event_type") @db.VarChar(100)
  severity      String?   @db.VarChar(20)

  ipAddress     String?   @map("ip_address") @db.Inet
  userAgent     String?   @map("user_agent")

  // SSO
  ssoProvider   String?   @map("sso_provider") @db.VarChar(50)
  ssoError      String?   @map("sso_error")

  details       Json?
  resolved      Boolean?  @default(false)
  resolvedAt    DateTime? @map("resolved_at")
  resolvedById  String?   @map("resolved_by") @db.Uuid

  createdAt     DateTime  @default(now()) @map("created_at")

  // Relations
  user          User?     @relation("UserSecurityEvents", fields: [userId], references: [id])
  resolvedBy    User?     @relation("ResolvedByUser", fields: [resolvedById], references: [id])

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@index([resolved])
  @@map("security_events")
}

// =============================================
// REFERENCE DATA
// =============================================

model CallDisposition {
  code        String    @id @db.VarChar(50)
  label       String    @db.VarChar(255)
  description String?
  category    String?   @db.VarChar(50)

  isActive    Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("call_dispositions")
}
